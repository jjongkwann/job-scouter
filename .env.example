# 복사해서 .env로 (gitignore). 전부 절대 경로.
# llm 워커 계정으로 codex login — Docker는 호스트 ~/.codex 인증을 공유한다.
JOBSCOUTER_TEMPORAL=localhost:7233          # Temporal 서버 (LAN 서버면 <ip>:7233)
JOBSCOUTER_ES=http://localhost:9200         # Elasticsearch
JOBSCOUTER_JOBFEED=/path/to/jobfeed         # candidates.json·jobs.jsonl·proposals.json이 있는 디렉토리 (io 워커 필수 — 없으면 기동 거부)
# 그 상위(데이터 repo 루트)에 settings.json 필요 — {"keywords": [...], "zones": [[밴드, "라벨", "주소패턴"], ...]}
JOBSCOUTER_FACTBASE=/path/to/사실베이스.md   # 본인 확인 완료 경력 사실 문서
JOBSCOUTER_PROMPTS=/path/to/prompts         # rubric_v1.md가 있는 디렉토리 (prompts/rubric_v1.example.md 참조)
JOBSCOUTER_MODEL=gpt-6-astra
JOBSCOUTER_REASONING_EFFORT=xhigh
JOBSCOUTER_APP_EXAMPLE=example              # applications/ 아래 형식 앵커 회사 폴더명
JOBSCOUTER_PKB_CATEGORIES=career,about,상용 서비스 개발 및 운영   # ResumeSync가 읽는 PKB category(콤마 구분)
