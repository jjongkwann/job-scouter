# 서버 전용 — deploy/.env로 복사해서 채운다(gitignore). compose가 이 값들을 읽는다.
DATA_REPO=/path/to/private-data-repo   # jobfeed 저장소 clone(호스트 경로) — /work/repo로 마운트
# CLAUDE_CODE_OAUTH_TOKEN=             # 서버 호스트의 Claude Code가 로그인돼 있으면 불필요(~/.claude/.credentials.json 마운트). 아니면 `claude setup-token` 값을 넣고 주석 해제
GIT_AUTHOR_NAME=                       # candidates.json 자동 커밋 작성자
GIT_AUTHOR_EMAIL=
JOBSCOUTER_APP_EXAMPLE=example            # applications/ 아래 형식 앵커 회사 폴더명
